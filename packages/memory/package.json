{
  "name": "@zikaron/memory",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "types": "wrangler types -c test/wrangler.jsonc test/worker-configuration.d.ts",
    "typecheck": "bun run types > /dev/null && tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@vitest/coverage-istanbul": "^4.1.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
