{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zikaron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // A Story 1.8 decide as rotas e o domínio. Até lá o Worker não fica exposto em workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  // O GitHub App e o repositório do cofre são de um deploy, e entram como `--var` no deploy.
  // Enquanto algum estiver vazio, ou faltar um segredo, o cofre fica desligado. Os segredos são
  // GITHUB_APP_PRIVATE_KEY (a chave do App, em PKCS#8) e GITHUB_WEBHOOK_SECRET.
  // A identidade (ADR-0001 §1) também é de um deploy, e entra como `--var`: ACCESS_TEAM_DOMAIN é o
  // domínio do time no Access (`https://<time>.cloudflareaccess.com`), ACCESS_AUD o AUD da aplicação,
  // e ZIKARON_CLIENTS o JSON do Client ID de cada service token para o cliente (`name`, `exposed`,
  // `privileged`, `ownerClaims`). Vazios, ninguém entra: as rotas fora do webhook respondem 401, ou
  // 500 sem a configuração dos clientes.
  "vars": {
    "GITHUB_APP_ID": "",
    "GITHUB_INSTALLATION_ID": "",
    "VAULT_REPOSITORY": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ZIKARON_CLIENTS": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],
  "env": {
    // O staging (Story 1.8): a CI publica a cada merge na main, contra o cofre de teste. Fica no
    // workers.dev, com o Cloudflare Access na frente (ligado no painel) e o webhook do GitHub num
    // caminho de bypass. Bindings e vars não são herdados entre ambientes: vão repetidos aqui, e os
    // valores entram como `--var` no deploy (.github/workflows/staging.yml).
    "staging": {
      "name": "zikaron-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "GITHUB_APP_ID": "",
        "GITHUB_INSTALLATION_ID": "",
        "VAULT_REPOSITORY": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ZIKARON_CLIENTS": ""
      },
      "durable_objects": {
        "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
      }
    }
  }
}
