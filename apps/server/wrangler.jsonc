{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The top level is local only (tests and `wrangler dev`): the published Workers are under `env`.
  // A deploy or a `secret put` without `--env` goes to a separate Worker, never to production.
  "name": "zikaron-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The top level is for tests and local development, off workers.dev. CI always publishes with
  // `--env` (staging or producao), never this one.
  "workers_dev": false,
  "preview_urls": false,
  // The GitHub App and the vault's repository belong to a deploy, and come in as `--var` at deploy.
  // While any of them is empty, or a secret is missing, the vault stays off. The secrets are
  // GITHUB_APP_PRIVATE_KEY (the App's key, in PKCS#8) and GITHUB_WEBHOOK_SECRET.
  // Identity (ADR-0001 §1) also belongs to a deploy, and comes in as `--var`: ACCESS_TEAM_DOMAIN is
  // the team's Access domain (`https://<team>.cloudflareaccess.com`), ACCESS_AUD the application's
  // AUD, and ZIKARON_CLIENTS the JSON from each service token's Client ID to the client (`name`,
  // `exposed`, `privileged`, `ownerClaims`). Empty, nobody gets in: routes other than the webhook
  // and /health answer 401, or 500 without the clients' configuration.
  // ZIKARON_ENV and ZIKARON_COMMIT are the published environment and commit, which /health returns;
  // the deploy (.github/workflows/deploy.yml) also passes them as `--var`.
  "vars": {
    "GITHUB_APP_ID": "",
    "GITHUB_INSTALLATION_ID": "",
    "VAULT_REPOSITORY": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ZIKARON_CLIENTS": "",
    "ZIKARON_ENV": "",
    "ZIKARON_COMMIT": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],
  "env": {
    // Staging (Story 1.8): CI publishes on every merge to main, against the test vault. It lives on
    // workers.dev, with Cloudflare Access in front (turned on in the dashboard) and the GitHub
    // webhook and /health on bypass paths. Bindings and vars aren't inherited between environments:
    // they are repeated here, and the values come in as `--var` at deploy
    // (.github/workflows/deploy.yml).
    "staging": {
      "name": "zikaron-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "GITHUB_APP_ID": "",
        "GITHUB_INSTALLATION_ID": "",
        "VAULT_REPOSITORY": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ZIKARON_CLIENTS": "",
        "ZIKARON_ENV": "",
        "ZIKARON_COMMIT": ""
      },
      "durable_objects": {
        "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
      }
    },
    // Production (Story 1.9): release only, on the owner's order (.github/workflows/producao.yml),
    // against the real vault (docs/producao.md). Like staging: workers.dev, Access in front, the
    // webhook and /health on bypass, and the values as `--var` at deploy.
    "producao": {
      "name": "zikaron",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "GITHUB_APP_ID": "",
        "GITHUB_INSTALLATION_ID": "",
        "VAULT_REPOSITORY": "",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ZIKARON_CLIENTS": "",
        "ZIKARON_ENV": "",
        "ZIKARON_COMMIT": ""
      },
      "durable_objects": {
        "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
      }
    }
  }
}
